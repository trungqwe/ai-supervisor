{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewBundle",
  "type": "object",
  "required": [
    "bundle_id",
    "task_id",
    "attempt_id",
    "task_contract",
    "worker_claims",
    "actual_git_evidence",
    "actual_test_evidence",
    "policy_findings",
    "unverified_claims",
    "recommended_review_focus",
    "generated_at",
    "bundle_hash",
    "evidence_finalized_at_epoch_ms",
    "bundle_assembled_at_epoch_ms",
    "compilation_latency_ms",
    "latency_measurement_status",
    "nfr008_compliance_status"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "task_contract": {
      "type": "object"
    },
    "worker_claims": {
      "type": "object",
      "required": [
        "reported_head_sha"
      ],
      "properties": {
        "reported_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "actual_git_evidence": {
      "type": "object",
      "required": [
        "actual_base_sha",
        "actual_head_sha",
        "actual_changed_files",
        "diff_stat"
      ],
      "properties": {
        "actual_base_sha": {
          "type": "string"
        },
        "actual_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "actual_changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_stat": {
          "type": "string"
        }
      }
    },
    "actual_test_evidence": {
      "type": "object",
      "required": [
        "all_passed",
        "executed_commands"
      ],
      "properties": {
        "all_passed": {
          "type": "boolean"
        },
        "executed_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "passed",
          "details"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_review_focus": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_finalized_at_epoch_ms": {
      "type": "integer",
      "minimum": 1
    },
    "bundle_assembled_at_epoch_ms": {
      "type": "integer",
      "minimum": 1
    },
    "compilation_latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "latency_measurement_status": {
      "type": "string",
      "enum": [
        "MEASURED_IN_PROCESS",
        "RECOVERED_AFTER_RESTART"
      ]
    },
    "nfr008_compliance_status": {
      "type": "string",
      "enum": [
        "UNVERIFIED"
      ]
    }
  },
  "additionalProperties": false
}
