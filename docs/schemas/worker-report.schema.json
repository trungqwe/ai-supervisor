{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkerReport",
  "type": "object",
  "required": [
    "task_id",
    "attempt_id",
    "status",
    "branch",
    "base_sha",
    "head_sha",
    "files_changed",
    "commands_run",
    "tests",
    "build_status",
    "worker_claims",
    "ready_for_review"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "BLOCKED", "FAILED"]
    },
    "branch": { "type": "string" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "output_summary": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_suite", "passed", "failed"],
        "properties": {
          "test_suite": { "type": "string" },
          "passed": { "type": "integer" },
          "failed": { "type": "integer" }
        }
      }
    },
    "build_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "SKIPPED"]
    },
    "worker_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deviations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ready_for_review": { "type": "boolean" }
  },
  "additionalProperties": false
}
