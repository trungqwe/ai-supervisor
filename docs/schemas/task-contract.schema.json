{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskContract",
  "type": "object",
  "required": [
    "contract_id",
    "task_id",
    "revision_number",
    "phase_id",
    "objective",
    "requirements",
    "architecture_refs",
    "base_sha",
    "allowed_scope",
    "forbidden_scope",
    "constraints",
    "acceptance_criteria",
    "verification_requests",
    "required_evidence",
    "worker_profile",
    "report_contract",
    "stop_conditions"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^CONTRACT-[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9_-]+$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "architecture_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "allowed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1
    },
    "forbidden_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "worker_profile": {
      "type": "string"
    },
    "report_contract": {
      "type": "string"
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile_id",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "profile_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "parameters": {
            "type": "object"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
