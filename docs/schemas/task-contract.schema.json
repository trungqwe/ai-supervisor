{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskContract",
  "type": "object",
  "required": [
    "task_id",
    "phase_id",
    "objective",
    "requirements",
    "architecture_refs",
    "base_sha",
    "allowed_scope",
    "forbidden_scope",
    "constraints",
    "acceptance_criteria",
    "required_tests",
    "required_evidence",
    "worker_profile",
    "report_contract",
    "stop_conditions"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9_-]+$" },
    "phase_id": { "type": "string", "pattern": "^P[0-9]{2}$" },
    "objective": { "type": "string", "minLength": 10 },
    "requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "architecture_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "allowed_scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "worker_profile": { "type": "string" },
    "report_contract": { "type": "string" },
    "stop_conditions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
